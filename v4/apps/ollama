{
  "captainVersion": 4,
  "services": {
    "$$cap_appname": {
      "image": "ollama/ollama:$$cap_ollama_version",
      "volumes": [
        "$$cap_appname-data:/root/.ollama"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "ollama",
          "--version"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "caproverExtra": {
        "notExposeAsWebApp": "true"
      }
    }
  },
  "caproverOneClickApp": {
    "variables": [
      {
        "id": "$$cap_ollama_version",
        "label": "Ollama Version",
        "defaultValue": "0.35.1",
        "description": "Pinned stable Ollama release.",
        "validRegex": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
      }
    ],
    "instructions": {
      "start": "Ollama will run privately inside the CapRover network and persist downloaded models.",
      "end": "Ollama is available to other CapRover apps at http://srv-captain--$$cap_appname:11434"
    },
    "displayName": "Ollama",
    "isOfficial": false,
    "baseUrl": "https://github.com/ollama/ollama",
    "description": "Run language models locally with persistent model storage.",
    "documentation": "https://github.com/ollama/ollama"
  }
}
