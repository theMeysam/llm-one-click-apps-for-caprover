{
  "captainVersion": 4,
  "services": {
    "$$cap_appname": {
      "image": "mintplexlabs/anythingllm:$$cap_llm_version",
      "environment": {
        "UID": "$$cap_uid",
        "GID": "$$cap_gid",
        "STORAGE_DIR": "/app/server/storage",
        "GENERATE_SOURCEMAP": "false",
        "DISABLE_TELEMETRY": "true"
      },
      "volumes": [
        "$$cap_appname-storage:/app/server/storage"
      ],
      "caproverExtra": {
        "containerHttpPort": 3001
      }
    }
  },
  "caproverOneClickApp": {
    "variables": [
      {
        "id": "$$cap_llm_version",
        "label": "AnythingLLM Version",
        "defaultValue": "1.17.0",
        "description": "Pinned stable Docker Hub tag. AnythingLLM image tags do not use a leading v.",
        "validRegex": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
      },
      {
        "id": "$$cap_uid",
        "label": "User ID",
        "defaultValue": "1000",
        "description": "The official container runs as UID 1000 by default.",
        "validRegex": "/^[0-9]+$/"
      },
      {
        "id": "$$cap_gid",
        "label": "Group ID",
        "defaultValue": "1000",
        "description": "The official container runs as GID 1000 by default.",
        "validRegex": "/^[0-9]+$/"
      }
    ],
    "instructions": {
      "start": "AnythingLLM Docker with persistent /app/server/storage. The version is pinned to the latest stable release rather than the moving latest image.",
      "end": "AnythingLLM is deployed at https://$$cap_appname.$$cap_root_domain\nEnable HTTPS in CapRover before production use."
    },
    "displayName": "AnythingLLM",
    "isOfficial": false,
    "baseUrl": "https://github.com/Mintplex-Labs/anything-llm",
    "description": "Self-hosted multi-user AI, RAG and agent workspace with persistent storage.",
    "documentation": "https://docs.anythingllm.com/installation-docker/local-docker"
  }
}
