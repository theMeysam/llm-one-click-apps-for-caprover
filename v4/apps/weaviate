{
  "captainVersion": 4,
  "services": {
    "$$cap_appname": {
      "image": "cr.weaviate.io/semitechnologies/weaviate:$$cap_weaviate_version",
      "command": [
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--scheme",
        "http"
      ],
      "volumes": [
        "$$cap_appname-data:/var/lib/weaviate"
      ],
      "restart": "unless-stopped",
      "environment": {
        "QUERY_DEFAULTS_LIMIT": "25",
        "PERSISTENCE_DATA_PATH": "/var/lib/weaviate",
        "CLUSTER_HOSTNAME": "node1",
        "AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED": "false",
        "AUTHENTICATION_APIKEY_ENABLED": "true",
        "AUTHENTICATION_APIKEY_ALLOWED_KEYS": "$$cap_weaviate_api_key",
        "AUTHENTICATION_APIKEY_USERS": "admin",
        "AUTHORIZATION_ADMINLIST_ENABLED": "true",
        "AUTHORIZATION_ADMINLIST_USERS": "admin",
        "DEFAULT_VECTORIZER_MODULE": "none"
      },
      "caproverExtra": {
        "notExposeAsWebApp": "true"
      }
    }
  },
  "caproverOneClickApp": {
    "variables": [
      {
        "id": "$$cap_weaviate_version",
        "label": "Weaviate Version",
        "defaultValue": "1.39.10",
        "description": "Pinned stable Weaviate release.",
        "validRegex": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
      },
      {
        "id": "$$cap_weaviate_api_key",
        "label": "API Key",
        "defaultValue": "$$cap_gen_random_hex(32)",
        "description": "API key for the default admin user.",
        "validRegex": "/.{16,}/"
      }
    ],
    "instructions": {
      "start": "Weaviate will run privately on the CapRover network with API-key authentication and persistent storage.",
      "end": "Internal endpoint: http://srv-captain--$$cap_appname:8080\nUser: admin\nConfigure clients with the API key entered during installation."
    },
    "displayName": "Weaviate",
    "isOfficial": false,
    "baseUrl": "https://github.com/weaviate/weaviate",
    "description": "AI-native vector database with persistent storage and secure-by-default API-key authentication.",
    "documentation": "https://docs.weaviate.io/"
  }
}
