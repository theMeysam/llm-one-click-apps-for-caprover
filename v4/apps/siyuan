{
  "captainVersion": 4,
  "services": {
    "$$cap_appname": {
      "image": "b3log/siyuan:$$cap_siyuan_version",
      "command": [
        "serve",
        "--workspace=/siyuan/workspace/",
        "--accessAuthCode=$$cap_access_auth_code"
      ],
      "environment": {
        "PUID": "$$cap_puid",
        "PGID": "$$cap_pgid",
        "SIYUAN_LANG": "$$cap_lang"
      },
      "volumes": [
        "$$cap_appname-workspace:/siyuan/workspace"
      ],
      "restart": "unless-stopped",
      "caproverExtra": {
        "containerHttpPort": 6806,
        "websocketSupport": "true"
      }
    }
  },
  "caproverOneClickApp": {
    "variables": [
      {
        "id": "$$cap_siyuan_version",
        "label": "SiYuan Version",
        "defaultValue": "v3.8.6",
        "description": "Pinned latest stable SiYuan release.",
        "validRegex": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/"
      },
      {
        "id": "$$cap_access_auth_code",
        "label": "Access Auth Code",
        "defaultValue": "$$cap_gen_random_hex(24)",
        "description": "Required lock-screen password for browser access. Keep it secret.",
        "validRegex": "/.{8,}/"
      },
      {
        "id": "$$cap_puid",
        "label": "PUID",
        "defaultValue": "1000",
        "description": "User ID used by the container for workspace files.",
        "validRegex": "/^[0-9]+$/"
      },
      {
        "id": "$$cap_pgid",
        "label": "PGID",
        "defaultValue": "1000",
        "description": "Group ID used by the container for workspace files.",
        "validRegex": "/^[0-9]+$/"
      },
      {
        "id": "$$cap_lang",
        "label": "Interface Language",
        "defaultValue": "en",
        "description": "BCP 47 language tag such as en, zh-CN, ja or pt-BR.",
        "validRegex": "/.{2,}/"
      }
    ],
    "instructions": {
      "start": "SiYuan is a privacy-first knowledge management system. This template runs the required serve subcommand, persists the complete workspace, enables WebSocket support, and requires an access authentication code.",
      "end": "SiYuan is deployed at https://$$cap_appname.$$cap_root_domain\nEnable HTTPS before production use. Keep this app at a single replica: one workspace must have only one active writer."
    },
    "displayName": "SiYuan",
    "isOfficial": false,
    "baseUrl": "https://github.com/siyuan-note/siyuan",
    "description": "Privacy-first personal knowledge management with a persistent single-writer workspace.",
    "documentation": "https://github.com/siyuan-note/siyuan#docker-hosting"
  }
}
